# Copy to .env and adjust. Never commit .env.
# docker compose reads it automatically; Spring reads the same names.

# ----- App -----
APP_NAME=springboot-starter
# dev | prod
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# vi | en (when no Accept-Language header)
APP_DEFAULT_LOCALE=vi
# prod profile: disable in real production
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Database -----
DB_NAME=starter
DB_USERNAME=starter
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_PORT=3306
# DB_HOST=localhost                  # docker compose sets this to "mysql"

# ----- JWT -----
# Generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
JWT_ISSUER=springboot-starter
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
PASSWORD_RESET_TTL=30m

# ----- Bootstrap admin (created on first start if missing; leave empty to skip) -----
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=Admin@123456
APP_ADMIN_FULL_NAME=Administrator

# ----- Mail -----
# log (print to console) | smtp
MAIL_PROVIDER=log
MAIL_FROM=no-reply@example.com
RESET_PASSWORD_URL=http://localhost:3000/reset-password
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ----- File storage -----
# local | (your own, e.g. s3)
STORAGE_PROVIDER=local
# Docker image uses /app/uploads (volume)
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE=10MB
